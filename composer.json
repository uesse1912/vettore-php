{
    "name": "vettore/vettore-php",
    "description": "SDK PHP ufficiale per Vettore: tracking unificato dei corrieri italiani, giacenze e disposizioni di svincolo, webhook firmati.",
    "type": "library",
    "license": "MIT",
    "keywords": ["vettore", "sdk", "api", "tracking", "giacenze", "gls", "brt", "sda", "corrieri", "logistica"],
    "homepage": "https://api.vettoreapi.com/docs",
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.8",
        "psr/log": "^2.0 || ^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5 || ^12.0",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Vettore\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vettore\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=512M",
        "check": ["@test", "@analyse"]
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
